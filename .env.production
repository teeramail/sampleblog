# Database URL (you'll need to add this in Vercel dashboard)
DATABASE_URL="postgresql://username:password@host:port/database"

# Next Auth
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="https://sampleblog-one.vercel.app"

# AWS S3 configuration
AWS_S3_ROOT_FOLDER="sampleblog"

# Add other necessary environment variables without sensitive values
